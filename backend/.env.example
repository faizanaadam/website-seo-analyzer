# Server Configuration
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development

# LLM Configuration (OpenAI / Gemini)
LLM_PROVIDER=openai
OPENAI_API_KEY=
LLM_API_KEY=
OPENAI_MODEL=gpt-4o-mini
LLM_MODEL=gpt-4o-mini

# External APIs
PAGESPEED_API_KEY=
GOOGLE_PAGESPEED_API_KEY=
GOOGLE_PLACES_API_KEY=

# Resilience & Timeouts (Optional)
OPENAI_TIMEOUT_SECONDS=30.0
OPENAI_MAX_RETRIES=2
OPENAI_DEADLINE_SECONDS=45.0
PAGESPEED_TIMEOUT_SECONDS=60.0
PAGESPEED_MAX_RETRIES=2
PAGESPEED_DEADLINE_SECONDS=60.0
PAGESPEED_CACHE_TTL_SECONDS=600
PLACES_TIMEOUT_SECONDS=10.0
PLACES_MAX_RETRIES=2
PLACES_DEADLINE_SECONDS=15.0
PLACES_CACHE_TTL_SECONDS=900
